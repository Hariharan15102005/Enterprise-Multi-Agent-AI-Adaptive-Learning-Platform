# ==============================================================================
# OlistIQ — Environment Configuration Template
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Configuration (PostgreSQL default; supports SQLite fallback for local test)
# For PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/olistiq
# For Local Analytical SQLite: sqlite:///data/processed/olistiq.db
DATABASE_URL=sqlite:///data/processed/olistiq.db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=olistiq
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password

# Raw Data Directory (Immutable)
RAW_DATA_PATH=archive/

# Processed & Quarantine Output Paths
PROCESSED_DATA_PATH=data/processed/
QUARANTINE_DATA_PATH=data/quarantine/

# Batch / Pipeline Settings
BATCH_SIZE=10000
IDEMPOTENT_MODE=REPLACE_ALL
